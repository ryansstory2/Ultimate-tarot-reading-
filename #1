        /* ==========================================================================
           2. APP STATE MANAGEMENT & LOCAL STORAGE
           ========================================================================== */
        let activeSpread = 'single';
        let activeReadingCards = [];
        let editingCardId = null;

        // Load saved custom styles from LocalStorage if present
        function initApp() {
            const savedCustoms = localStorage.getItem('dali_tarot_customizations');
            if (savedCustoms) {
                try {
                    const parsed = JSON.parse(savedCustoms);
                    parsed.forEach(saved => {
                        const card = TAROT_DECK.find(c => c.id === saved.id);
                        if (card) {
                            card.custom = { ...card.custom, ...saved.custom };
                        }
                    });
                } catch(e) {
                    console.error("Failed to parse saved customizations", e);
                }
            }
            renderGalleryGrid();
        }

        function saveCustomizationsToStorage() {
            const exportData = TAROT_DECK.map(c => ({ id: c.id, custom: c.custom }));
            localStorage.setItem('dali_tarot_customizations', JSON.stringify(exportData));
        }

        /* ==========================================================================
