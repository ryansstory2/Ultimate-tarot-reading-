        /* ==========================================================================
           4. CARD DRAW & TAROT SPREAD RENDERING
           ========================================================================== */
        function selectSpread(type) {
            activeSpread = type;
            document.querySelectorAll('.spread-btn').forEach(btn => {
                btn.classList.remove('border-amber-500/40', 'bg-amber-950/20');
                btn.classList.add('border-amber-500/20', 'bg-black/40');
            });
            event.currentTarget.classList.remove('border-amber-500/20', 'bg-black/40');
            event.currentTarget.classList.add('border-amber-500/40', 'bg-amber-950/20');
        }

        function drawCards() {
            const board = document.getElementById('reading-board');
            const interpSection = document.getElementById('reading-interpretation');
            const interpContent = document.getElementById('interpretation-content');
            
            board.innerHTML = '';
            interpSection.classList.add('hidden');

            let cardCount = 1;
            if (activeSpread === 'three') cardCount = 3;
            else if (activeSpread === 'five') cardCount = 5;
            else if (activeSpread === 'celtic') cardCount = 10;
            else if (activeSpread === 'lovers') cardCount = 4;
            else if (activeSpread === 'career') cardCount = 4;

            // Shuffle Deck
            const shuffled = [...TAROT_DECK].sort(() => 0.5 - Math.random());
            activeReadingCards = shuffled.slice(0, cardCount);

            // Render Drawn Cards
            activeReadingCards.forEach((card, idx) => {
                const cardWrapper = document.createElement('div');
                cardWrapper.className = 'flex flex-col items-center animate-fade-in my-2';
                
                cardWrapper.innerHTML = `
                    <div class="card-container w-[200px] sm:w-[220px] aspect-[2/3] cursor-pointer" onclick="flipCard(this, ${card.id})">
                        <div class="card-inner">
                            <!-- Card Back -->
                            <div class="card-back border-2 border-amber-500/40 bg-gradient-to-b from-gray-950 via-purple-950 to-gray-950 flex flex-col items-center justify-center p-4 shadow-xl">
                                <div class="w-full h-full border border-amber-500/20 rounded-lg flex flex-col items-center justify-center">
                                    <div class="text-4xl text-amber-400 mb-2 animate-pulse">👁️</div>
                                    <p class="font-cinzel text-xs text-amber-300 tracking-widest text-center uppercase">Dalí Surreal Oracle</p>
                                    <p class="text-[10px] text-gray-500 mt-1">Tap to Reveal</p>
                                </div>
                            </div>
                            <!-- Card Front -->
                            <div class="card-front border border-amber-500/30 rounded-2xl bg-black overflow-hidden shadow-[0_0_20px_rgba(0,0,0,0.8)]">
                                ${generateCardSVG(card)}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Action Controls below drawn card -->
                    <div class="mt-3 flex items-center space-x-2 opacity-90">
                        <button onclick="openCustomizerModal(${card.id})" class="px-3 py-1 text-xs rounded-full border border-amber-500/40 bg-amber-950/60 hover:bg-amber-900/80 text-amber-200 transition flex items-center space-x-1 shadow">
                            <i class="fa-solid fa-wand-magic">
</i>
                            <span>Edit Card Art</span>
                        </button>
                    </div>
                `;
                board.appendChild(cardWrapper);
            });

            // Automatically Flip Cards with Staggered Delays
            setTimeout(() => {
                const containers = document.querySelectorAll('.card-container');
                containers.forEach((c, index) => {
                    setTimeout(() => {
                        c.classList.add('flipped');
                    }, index * 250);
                });
            }, 300);

            // Generate Reading Summary
            generateInterpretation(activeReadingCards);
        }

        function flipCard(container, cardId) {
            container.classList.toggle('flipped');
        }

        /* ==========================================================================
           5. INTERPRETATION ENGINE
           ========================================================================== */
        function generateInterpretation(cards) {
            const interpSection = document.getElementById('reading-interpretation');
            const interpContent = document.getElementById('interpretation-content');
            
            let html = '';
            cards.forEach((card, i) => {
                let positionName = `Card ${i+1}`;
                if (activeSpread === 'three') positionName = ["Past / Foundation", "Present / Catalyst", "Future / Horizon"][i];
                else if (activeSpread === 'single') positionName = "Daily Oracle Focus";
                
                html += `
                    <div class="bg-gray-950/60 border border-amber-900/30 rounded-xl p-4">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs uppercase font-bold tracking-widest text-amber-400">${positionName}</span>
                            <span class="text-sm font-cinzel font-bold text-amber-200">${card.numeral}. ${card.name}</span>
                        </div>
                        <p class="text-xs text-amber-300/80 italic mb-2">"${card.subtitle}"</p>
                        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">${card.meaning}</p>
                        <div class="mt-2 flex flex-wrap gap-1">
                            ${card.keywords.map(k => `<span class="text-[10px] bg-amber-950/50 text-amber-300 border border-amber-800/40 px-2 py-0.5 rounded-md">${k}</span>`).join('')}
                        </div>
                    </div>
                `;
            });

            interpContent.innerHTML = html;
            setTimeout(() => {
                interpSection.classList.remove('hidden');
            }, cards.length * 250 + 400);
        }

        /* ==========================================================================
           6. LIVE SVG CUSTOMIZER & EDITOR LOGIC
           ========================================================================== */
        function openCustomizerModal(cardId) {
            editingCardId = cardId;
            const card = TAROT_DECK.find(c => c.id === cardId);
            if (!card) return;

            // Update Modal Headers
            document.getElementById('modal-card-title').innerText = `Editing: ${card.name}`;
            document.getElementById('modal-card-num').innerText = `ARCANA ${card.numeral}`;

            // Populate Controls with Card's Current Custom Styles
            const c = card.custom;
            document.getElementById('ctrl-bg-top').value = c.bgTop || "#0a0812";
            document.getElementById('ctrl-bg-bottom').value = c.bgBottom || "#141124";
            document.getElementById('ctrl-gold-color').value = c.goldColor || "#ffd54f";
            document.getElementById('ctrl-accent-color').value = c.accentColor || "#d4af37";

            document.getElementById('ctrl-drip-length').value = c.dripLength || 1.0;
            document.getElementById('val-drip-length').innerText = c.dripLength || 1.0;

            document.getElementById('ctrl-distortion').value = c.distortion || 0;
            document.getElementById('val-distortion').innerText = `${c.distortion || 0} deg`;

            document.getElementById('ctrl-glow').value = c.glow || 50;
            document.getElementById('val-glow').innerText = `${c.glow || 50}%`;

            document.getElementById('ctrl-toggle-elephants').checked = !!c.elephants;
            document.getElementById('ctrl-toggle-crutches').checked = !!c.crutches;
            document.getElementById('ctrl-toggle-stars').checked = !!c.stars;
            document.getElementById('ctrl-toggle-keyhole').checked = !!c.keyhole;

            // Render Live Preview
            renderModalPreview();

            // Show Modal
            document.getElementById('customizer-modal').classList.remove('hidden');
        }

        function closeCustomizerModal() {
            document.getElementById('customizer-modal').classList.add('hidden');
            // Refresh main board SVGs
            refreshActiveBoard();
            saveCustomizationsToStorage();
        }

        function renderModalPreview() {
            const card = TAROT_DECK.find(c => c.id === editingCardId);
            if (!card) return;
            const previewContainer = document.getElementById('modal-svg-preview-container');
            previewContainer.innerHTML = generateCardSVG(card, true);
        }

        function updateCardStyle() {
            const card = TAROT_DECK.find(c => c.id === editingCardId);
            if (!card) return;

            // Read Input Values
            card.custom.bgTop = document.getElementById('ctrl-bg-top').value;
            card.custom.bgBottom = document.getElementById('ctrl-bg-bottom').value;
            card.custom.goldColor = document.getElementById('ctrl-gold-color').value;
            card.custom.accentColor = document.getElementById('ctrl-accent-color').value;

            card.custom.dripLength = parseFloat(document.getElementById('ctrl-drip-length').value);
            document.getElementById('val-drip-length').innerText = card.custom.dripLength;

            card.custom.distortion = parseInt(document.getElementById('ctrl-distortion').value);
            document.getElementById('val-distortion').innerText = `${card.custom.distortion} deg`;

            card.custom.glow = parseInt(document.getElementById('ctrl-glow').value);
            document.getElementById('val-glow').innerText = `${card.custom.glow}%`;

            card.custom.elephants = document.getElementById('ctrl-toggle-elephants').checked;
            card.custom.crutches = document.getElementById('ctrl-toggle-crutches').checked;
            card.custom.stars = document.getElementById('ctrl-toggle-stars').checked;
            card.custom.keyhole = document.getElementById('ctrl-toggle-keyhole').checked;

            // Update Modal SVG Live
            renderModalPreview();
        }

        function applyPresetTheme(themeKey) {
            const card = TAROT_DECK.find(c => c.id === editingCardId);
            if (!card) return;

            if (themeKey === 'obsidian') {
                card.custom = { ...card.custom, bgTop: "#050505", bgBottom: "#1a1600", goldColor: "#ffd700", accentColor: "#d4af37", glow: 70 };
            } else if (themeKey === 'dusk') {
                card.custom = { ...card.custom, bgTop: "#2b092b", bgBottom: "#5e1933", goldColor: "#ff91a4", accentColor: "#f43f5e", glow: 60 };
            } else if (themeKey === 'cyber') {
                card.custom = { ...card.custom, bgTop: "#03111a", bgBottom: "#022c38", goldColor: "#00f3ff", accentColor: "#38bdf8", glow: 85 };
            } else if (themeKey === 'sepia') {
                card.custom = { ...card.custom, bgTop: "#241c12", bgBottom: "#42321e", goldColor: "#fef08a", accentColor: "#ca8a04", glow: 30 };
            }

            openCustomizerModal(editingCardId); // Refresh controls view
        }

        function applyStyleToAllCards() {
            const currentCard = TAROT_DECK.find(c => c.id === editingCardId);
            if (!currentCard) return;

            const styleToCopy = { ...currentCard.custom };
            TAROT_DECK.forEach(c => {
                c.custom = { ...styleToCopy };
            });

            alert("Applied current Surrealist Style to all 17 Major Arcana cards!");
            refreshActiveBoard();
            saveCustomizationsToStorage();
        }

        function resetCurrentCardStyle() {
            const card = TAROT_DECK.find(c => c.id === editingCardId);
            if (!card) return;

            card.custom = {
                bgTop: "#0a0812", bgBottom: "#141124", goldColor: "#ffd54f", accentColor: "#d4af37",
                dripLength: 1.0, distortion: 0, glow: 50,
                elephants: true, crutches: true, stars: true, keyhole: false
            };

            openCustomizerModal(editingCardId);
        }

        function refreshActiveBoard() {
            if (activeReadingCards.length > 0) {
                // Re-render board with updated SVG styles without breaking card flips
                const containers = document.querySelectorAll('.card-front');
                containers.forEach((front, idx) => {
                    if (activeReadingCards[idx]) {
                        front.innerHTML = generateCardSVG(activeReadingCards[idx]);
                    }
                });
            }
        }

        /* ==========================================================================
           7. GALLERY DECK DRAWER
           ========================================================================== */
        function toggleCardDeckDrawer() {
            const modal = document.getElementById('deck-drawer-modal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                renderGalleryGrid();
            }
        }

        function renderGalleryGrid() {
            const grid = document.getElementById('gallery-grid');
            grid.innerHTML = '';

            TAROT_DECK.forEach(card => {
                const item = document.createElement('div');
                item.className = 'flex flex-col items-center group cursor-pointer';
                item.innerHTML = `
                    <div class="w-full aspect-[2/3] rounded-xl overflow-hidden border border-amber-500/30 group-hover:border-amber-400 group-hover:shadow-[0_0_15px_rgba(212,175,55,0.4)] transition" onclick="openCustomizerModal(${card.id}); toggleCardDeckDrawer();">
                        ${generateCardSVG(card)}
                    </div>
                    <span class="text-xs text-amber-200 mt-2 font-medium group-hover:text-amber-400">${card.numeral}. ${card.name}</span>
                `;
                grid.appendChild(item);
            });
        }

        function openGlobalThemeModal() {
            // Open editor for Card 0 as default global baseline
            openCustomizerModal(0);
        }

        function resetApp() {
            document.getElementById('reading-board').innerHTML = `
                <div class="text-center text-gray-500 my-12">
                    <i class="fa-solid fa-hand-holding-magic text-5xl mb-4 text-amber-500/30">
</i>
                    <p class="text-sm uppercase tracking-widest font-semibold">Press "Draw Surreal Tarot" to Consult the Oracle</p>
                </div>
            `;
            document.getElementById('reading-interpretation').classList.add('hidden');
            activeReadingCards = [];
        }

        // Initialize application on load
        window.onload = initApp;
    </script>
</body>
</html>
